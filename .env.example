# Copy to .env and fill in. Never commit .env.

# --- Core ---
SECRET_KEY=change-me-to-a-long-random-string   # python -c "import secrets; print(secrets.token_hex(32))"
FLASK_DEBUG=0
BASE_URL=                  # e.g. https://www.yourdomain.com (used for sitemap/canonical links)
COOKIE_SECURE=0            # set to 1 when the site runs on HTTPS
TRUST_PROXY=0              # set to 1 when behind nginx/Apache/hosting proxy
TIMEZONE=Asia/Kolkata
# DATABASE_URL=postgresql://user:pass@host/dbname   # leave unset to use SQLite

# --- Teacher details (all shown on the website) ---
TEACHER_NAME=Jancy T
TEACHER_PHONE=+91 00000 00000
WHATSAPP_NUMBER=910000000000   # digits only, with country code, no + or spaces
TEACHER_EMAIL=
TEACHER_ADDRESS=Vengadamangalam
GOOGLE_MAPS_URL=               # paste a Google Maps share link
TEACHER_PHOTO=teacher-placeholder.svg   # file inside app/static/images/
OG_IMAGE=                      # optional, e.g. og-image.jpg inside app/static/images/
INSTAGRAM_URL=
FACEBOOK_URL=
YOUTUBE_URL=

# --- Email notifications (optional; the site works without them) ---
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_SENDER=
NOTIFY_EMAIL=                  # where new applications are emailed
